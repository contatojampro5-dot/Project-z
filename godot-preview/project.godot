; Project Z — Prólogo "Dia Zero" (Godot 4.7, cidade 3D)
config_version=5

[application]

config/name="Project Z - Prologo Dia Zero"
config/description="Prologo do Project Z: o primeiro dia do surto na Zona Leste de Sao Paulo."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.04, 0.045, 0.035, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2
limits/opengl/max_lights_per_object=12

[shader_globals]

foco_tela={
"type": "vec2",
"value": Vector2(0, 0)
}
raio_tela={
"type": "float",
"value": 180.0
}

noite={
"type": "float",
"value": 0.0
}
